# deploy-offline-el8.sh configuration
# Copy to .env and edit before deploying. .env is git-ignored — never commit it.

# --- SoftHSM token -----------------------------------------------------------
SOFTHSM_TOKEN_LABEL=openbao-token
SOFTHSM_PIN=246810
SOFTHSM_SO_PIN=246810

# AES key used by OpenBao to seal/unseal (created if missing)
SOFTHSM_KEY_LABEL=bao-root-key

# --- OpenBao -----------------------------------------------------------------
BAO_API_ADDR=https://127.0.0.1:8200
BAO_CLUSTER_ADDR=https://127.0.0.1:8201

# --- Initial credentials -----------------------------------------------------
# Recovery key shares/threshold generated at first init
RECOVERY_SHARES=1
RECOVERY_THRESHOLD=1
